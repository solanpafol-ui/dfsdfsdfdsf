{
  "manifest_version": 3,
  "name": "MotionDeck Shield",
  "version": "1.0.0",
  "description": "Anti-detection and region stamp for the MotionDeck browser backend.",
  "permissions": ["cookies", "storage"],
  "host_permissions": ["*://*.dola.com/*"],
  "background": { "service_worker": "sw.js" },
  "content_scripts": [
    {
      "matches": ["*://*.dola.com/*"],
      "run_at": "document_start",
      "js": ["content.js"],
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    { "resources": ["main.js"], "matches": ["*://*.dola.com/*"] }
  ]
}